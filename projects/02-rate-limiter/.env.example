# Copy to `.env` and adjust. Every value has a working default — a bare
# `make run` against the compose Redis starts a usable service.
# `.env` is gitignored — never commit real secrets.

# --- serving ---
# gRPC listens here; 50051 is the conventional gRPC dev port.
PORT=50051
# Plain HTTP for /healthz + /metrics (repo port convention: 9100 -> 91NN).
METRICS_PORT=9102
LOG_LEVEL=info

# --- the default limit applied to every key (per-tier config comes later) ---
# Sustained refill rate in tokens/sec, and the burst (bucket capacity).
RATE_PER_SEC=10
BURST=20
# Which algorithm the distributed limiter uses: token_bucket | sliding_window
ALGORITHM=token_bucket

# --- shared state (V3) ---
# Redis holds the limiter state (matches docker-compose.yml).
REDIS_URL=redis://localhost:6302/0
# Connection pool ceiling. Size this together with MAX_CONCURRENT_RPCS — an
# unbounded pool turns a slow Redis into unbounded memory and file descriptors.
REDIS_MAX_CONNECTIONS=64
# How long an idle key's state survives before self-evicting. Must comfortably
# exceed a full refill, or a throttled caller comes back with a fresh bucket.
KEY_TTL_SECONDS=3600

# --- failure policy ---
# What to do when Redis is unreachable:
#   true  = fail open (allow the request — availability over protection)
#   false = fail closed (deny — protection over availability)
FAIL_OPEN=true
# Server-side ceiling on in-flight RPCs: backpressure instead of an OOM.
MAX_CONCURRENT_RPCS=1000
