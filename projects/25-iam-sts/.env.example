# Copy to .env and adjust. Every value has a working default — a bare `make run`
# starts an account seeded with the bootstrap (root) credentials below and
# nothing else.

# --- server ---
# The AWS-shaped API: STS actions (AssumeRole, GetCallerIdentity) and IAM
# management actions. Every request here must be SigV4-signed.
PORT=9025
# The authorization endpoint the *other* projects call — 23's data plane, 24's
# invoke path, 06's object store. It is a separate listener for the same reason
# real IAM's authorization plane is separate from its management API: the hot
# path must not share a bottleneck with people editing policies, and you want to
# be able to benchmark it alone.
AUTHZ_PORT=9026
# Loopback only. The authorization endpoint is an internal service contract.
AUTHZ_HOST=127.0.0.1
LOG_LEVEL=info

# --- account identity ---
# This node models exactly one account. Cross-account evaluation (V3) is tested
# by naming a *different* account id in a resource or trust policy — you do not
# need a second node to hit the asymmetry that makes cross-account safe.
ACCOUNT_ID=000000000000
AWS_REGION=us-east-1
AWS_PARTITION=aws

# --- bootstrap credentials (the account root) ---
# Seeded at startup so there is something to sign with before any user exists —
# the chicken-and-egg every identity service has. This is AWS's own published
# documentation example key pair: it is famous, worthless, and deliberately not
# a secret. Replace it in .env if you want the habit.
BOOTSTRAP_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
BOOTSTRAP_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# --- SigV4 (V1) ---
# How far a request's timestamp may be from ours before it is refused. Real AWS
# allows 5 minutes. This window is also the *minimum* lifetime of the replay
# cache — a signature cannot be replayed after it has aged out of acceptance, so
# the two numbers are the same number for a reason.
SIGV4_CLOCK_SKEW_SECONDS=300
# Cap on a presigned URL's X-Amz-Expires. Real AWS: 7 days for SigV4.
PRESIGN_MAX_EXPIRY_SECONDS=604800
# Derived signing keys are per (secret, date, region, service), so they are
# extremely cacheable — and extremely sensitive. Bounded on purpose.
SIGNING_KEY_CACHE_SIZE=1024

# --- policy limits (V2) ---
# Real IAM's managed-policy limit is 6144 characters, and it exists because an
# unbounded policy is an unbounded evaluation on every request in the account.
MAX_POLICY_BYTES=6144
MAX_STATEMENTS_PER_POLICY=100
MAX_POLICIES_PER_PRINCIPAL=10
MAX_CONDITION_KEYS_PER_STATEMENT=32

# --- STS (V4) ---
# Signs and integrity-protects the session token. Anyone holding this can mint
# credentials for any role in the account — it is the single most valuable
# secret in this service. Rotating it (with an overlap window) is a horizontal
# checklist item.
SESSION_TOKEN_KEY=dev-only-session-token-key-replace-me
DEFAULT_SESSION_DURATION_SECONDS=3600
# Ceiling for a direct AssumeRole. Real STS: 12 hours.
MAX_SESSION_DURATION_SECONDS=43200
# Role chaining truncates you to one hour no matter what you asked for. This is
# the cap people discover in production, at hour two of a long job.
CHAINED_SESSION_MAX_DURATION_SECONDS=3600
MAX_ROLE_CHAIN_DEPTH=2

# --- authorizer hot path (V5) ---
# Bounded: an unbounded decision cache is an unbounded memory leak keyed by
# whatever a caller feels like sending.
DECISION_CACHE_SIZE=100000
# Read this as a SECURITY parameter, not a performance one: it is the maximum
# time a revoked permission keeps working. Every millisecond you add here buys
# throughput and sells the blast radius of a revoke.
DECISION_CACHE_TTL_SECONDS=1.0
# Compiled policies are the expensive artifact — parsed, validated and turned
# into a matcher once instead of per request.
COMPILED_POLICY_CACHE_SIZE=4096

# --- audit & revocation (V6) ---
AUDIT_LOG_PATH=./run/audit.log
# Bounded on purpose: an auditor losing records is bad, but an audit buffer
# taking the authorizer down with it is worse. V6 asks you to shed *explicitly*.
AUDIT_QUEUE_SIZE=10000
AUDIT_FLUSH_INTERVAL_SECONDS=1.0
# How often expired sessions are swept out of the session table. Expiry itself
# is enforced by the token's own claim — this only reclaims memory.
SESSION_REAP_INTERVAL_SECONDS=30.0
