# Copy to `.env` and adjust. `.env` is gitignored — never commit real secrets.

# --- Ports ---
# The HTTP control plane: POST /torrents, GET /torrents, /healthz, /metrics.
# Observation and control, never peer data.
PORT=8080

# The port we LISTEN on for inbound peers, and advertise to the tracker so other
# peers can dial us back. BitTorrent conventionally uses 6881–6889; the
# project-scoped default is 6819 (6881 with the last two digits → NN=19).
PEER_PORT=6819

# structlog level. JSON is chosen automatically when stderr is not a tty (Docker,
# CI); colour on a terminal. Nothing to configure for that.
LOG_LEVEL=info

# --- Storage ---
# Where downloaded and seeded piece data lives. Gitignored.
DOWNLOAD_DIR=./data

# How many OS threads serve piece reads and writes. Piece I/O is `os.pread` /
# `os.pwrite`, which are blocking calls — on the event loop they stall *every*
# peer, not just the one being served. This is the "bounded pool sized on
# purpose" checklist item: the number wants tuning together with MAX_PEERS, and
# the reasoning belongs in docs/19-design.md rather than in this file.
DISK_WORKERS=4

# --- Resource caps (the anti-flash-crowd bounds — see the boss fight) ---
# Max simultaneous peer connections across all torrents, inbound and outbound.
MAX_PEERS=50

# Hard cap on a peer message's *declared* length, enforced against the 4-byte
# length prefix before anything is allocated for it (V4). A real `piece` is a
# 16 KiB block plus a small header, so 1 MiB is generous — and a hostile peer's
# `0xFFFFFFFF` costs a comparison instead of a MemoryError.
MAX_MESSAGE_BYTES=1048576

# How many block requests to keep in flight per peer (V5). One-block-per-round-
# trip is the naive shape and it caps you at block_size/RTT no matter how fast
# the peer is; this is the dial that turns that into a pipeline.
PIPELINE_DEPTH=8

# --- Tracker (V3) ---
# Per-announce timeout, seconds. The criterion this serves: one dead tracker must
# not sink the download — an announce that hangs forever is a download that never
# starts, which is the same outage with a friendlier name.
ANNOUNCE_TIMEOUT_SECONDS=15

# --- Seeder (V6) ---
# Regular upload slots for the choke algorithm: at most this many peers are
# unchoked at once (+1 optimistic). This is the cap the boss fight verifies via
# the `bt_peers_unchoked` gauge.
UPLOAD_SLOTS=4

# Off by default so the bare scaffold serves the control plane without an accept
# loop raising on its first inbound peer. Flip on once V6 is implemented.
RUN_SEEDER=false

# --- Test swarm (docker compose up) --------------------------------------------------
# Not read by the app — this is where the compose dependencies live, for when you
# announce/leech/seed against them. Host ports are project-scoped (NN=19).
#   Tracker (opentracker, HTTP + UDP):   http://localhost:6919/announce   udp://localhost:6919
#   Reference peer (transmission) RPC:   http://localhost:9019/transmission/web/
#   Reference peer BitTorrent port:      51419  (TCP + UDP)
