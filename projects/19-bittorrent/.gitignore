# Local env + runtime data — never commit these.
.env
/data/

# Reference-peer (transmission) container state from docker-compose.
/transmission/

# Generated by `make torrent`: a throwaway .torrent + its payload, rebuilt on
# demand. The *corpus* the SPEC grades V1 and V2 against is a real .torrent you
# check in deliberately (tests/fixtures/), not this one — the point of that
# criterion is that your infohash matches what a real client publishes, and a
# torrent your own tooling generated cannot prove it.
/testfile.torrent

# Python
__pycache__/
.pytest_cache/
.ruff_cache/
