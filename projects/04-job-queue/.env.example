# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.

# HTTP API (enqueue + inspect)
PORT=8080
LOG_LEVEL=info               # debug|info|warning|error — JSON automatically when stderr isn't a tty

# Shared bearer token required on the mutating routes (POST /jobs, requeue). Send it
# as `Authorization: Bearer <token>`. UNSET/empty = auth disabled (dev only) — main
# warns loudly, and with the exec/shell job kinds an open POST /jobs is remote code
# execution, so set this in any shared/prod environment.
ENQUEUE_TOKEN=

# Postgres — the durable store AND the queue (claim via FOR UPDATE SKIP LOCKED).
DATABASE_URL=postgres://jobs:jobs@localhost:5404/jobs
DB_POOL_MIN=2
DB_POOL_MAX=20
# Size the pool WITH the worker count, not after it: each idle worker parks on a
# LISTEN, which holds one connection, so DB_POOL_MAX must exceed WORKER_CONCURRENCY
# with room left over for the API's own traffic.

# --- Worker pool ---
# Off by default so the API can be served without a worker pool attached.
RUN_WORKERS=false
WORKER_CONCURRENCY=4
QUEUE=default
POLL_INTERVAL_MS=1000        # idle re-check cadence; V4's LISTEN/NOTIFY is the fast path
CLAIM_BATCH=10               # jobs claimed per round-trip

# --- Visibility timeout / lease (V2) ---
# How long a claimed job stays invisible before the reaper assumes the worker
# died and makes it claimable again. Too short = spurious double-runs of slow
# jobs; too long = slow recovery from a crashed worker.
VISIBILITY_TIMEOUT_SECS=30
REAPER_INTERVAL_SECS=10

# --- Observability ---
GAUGE_INTERVAL_SECS=10       # how often queue depth / lag gauges are sampled

# --- Retries (V3) ---
DEFAULT_MAX_ATTEMPTS=5

# --- Job execution ---
# Per-attempt stdout/stderr capture for the exec/shell job kinds lands in
# {JOB_LOG_DIR}/{job_id}/{attempt}.log — kept out of the structured log stream
# because payloads and command output may carry secrets.
JOB_LOG_DIR=logs
