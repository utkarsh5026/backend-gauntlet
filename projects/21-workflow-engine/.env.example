# Copy to `.env` and adjust. Every value has a working default — a bare
# `make dev` against the compose Postgres starts a usable engine.
# `.env` is gitignored — never commit real secrets.

# --- serving ---
# gRPC frontend — where workers and starters connect. 7233 is Temporal's own
# frontend port (a nod); nothing forces it, but it keeps this engine off the
# rate-limiter's 50051 if you run both.
PORT=7233
# Plain HTTP for /healthz + /metrics (repo port convention: 9100 -> 91NN).
METRICS_PORT=9121
LOG_LEVEL=info
# Server-side ceiling on in-flight RPCs: backpressure instead of an OOM. Note
# that every parked long-poll is an in-flight RPC, so this has to exceed the
# number of workers you expect polling at once, with room to spare.
MAX_CONCURRENT_RPCS=1000
# Cap on a workflow/activity input or result. Payloads are opaque bytes the
# engine stores and never interprets — but unbounded, they are a way to fill an
# append-only table with a single RPC.
MAX_PAYLOAD_BYTES=2097152

# --- durable store ---
# Postgres is the source of truth (history, task queues, timers). Host port
# 5421 = 54NN with NN=21; keep this in lockstep with docker-compose.yml.
DATABASE_URL=postgres://workflow:workflow@localhost:5421/workflow
# Pool bounds. Every pooled connection is a backend process on the server, so
# DB_POOL_MAX × replicas must stay under its max_connections. Size this together
# with MAX_CONCURRENT_RPCS and write down why in docs/21-design.md.
DB_POOL_MIN=2
DB_POOL_MAX=20

# --- dispatch / long-poll (V4) ---
# How long PollWorkflowTask / PollActivityTask block before returning "no work".
# Long enough to amortize the round-trip, short enough that a worker notices
# shutdown.
LONG_POLL_TIMEOUT_MS=5000
# A claimed task that isn't completed within this window is assumed lost (the
# worker crashed) and returned to the queue for another worker — this is what
# makes delivery at-least-once and survives The Reaper.
TASK_VISIBILITY_TIMEOUT_MS=30000

# --- durable timers (V3) ---
# Off by default so the bare scaffold serves the API without the scan loop
# hitting a V3 NotImplementedError on its first pass. Flip on once V3 works.
RUN_TIMER_SERVICE=false
# How often the timer service scans for due timers. Smaller = tighter firing
# latency, more scan queries; this is a tradeoff you get to measure.
TIMER_SCAN_INTERVAL_MS=200
# How many due timers one pass claims. A bound, not a target: it keeps a single
# pass's transaction short when a burst comes due at once.
TIMER_SCAN_BATCH=100

# --- sticky cache (V5) ---
# How long an execution stays pinned to the worker that last ran it before
# follow-up tasks fall back to the normal queue (full replay). Ties the cache to
# worker liveness.
STICKY_TTL_MS=10000
