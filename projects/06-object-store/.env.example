# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.

# HTTP API (S3 path-style). 9000 is the MinIO/S3-local convention.
PORT=9000
LOG_LEVEL=info

# --- Storage ---
# Where the store lives. It creates objects/ (FileCas blobs), volumes/
# (Haystack needles), tmp/ (in-flight writes), cold/ (lifecycle-tiered blobs),
# quarantine/ (scrub failures), index/ (key→digest rows) and uploads/
# (multipart staging) under here. The filesystem IS the database — there is no
# other dependency.
DATA_DIR=./data

# --- Physical blob write policy (both backends always open under DATA_DIR) ---
# file_cas (default) — every commit under objects/ (one file per digest).
# haystack | hybrid — small objects → volumes/ needles; oversized → objects/.
# Reads follow the store's digest→location map, so changing this never strands
# bytes already written. See docs/11-how-haystack-packing-works.md.
# BLOB_LAYOUT=file_cas
# BLOB_LAYOUT=haystack
# BLOB_LAYOUT=hybrid
#
# Soft cap for one Haystack volume file, in bytes. Needles that do not fit fall
# back to FileCas under the haystack/hybrid policies. Default is 1 MiB; use
# 1073741824 (1 GiB) for denser packing in benches.
# HAYSTACK_MAX_VOLUME_SIZE=1073741824
#
# How often background compaction rewrites volumes holding tombstones. A no-op
# when nothing is dirty. Default 300s.
HAYSTACK_COMPACTION_INTERVAL_SECS=300

# --- Index-as-a-service (From the field) ---
# Two-process mode on the host (same DATA_DIR):
#   make index-svc
#   INDEX_URL=http://127.0.0.1:9106 make backend
# Leave INDEX_URL unset for the default in-process index.
INDEX_PORT=9106
# INDEX_URL=http://127.0.0.1:9106
#
# Container stack (index + API + web console) — preferred for the split:
#   make stack
#   console → http://localhost:5106   API → :9006   index → :9106
# Compose sets INDEX_URL and a shared volume, so you do not need it here.

# Hard cap on a single object or multipart part, in bytes. Enforced in the V2
# stream loop so a client cannot stream you out of disk — the framework has no
# body limit of its own, this is the real one. Default 5 GiB, S3's single-PUT
# ceiling.
MAX_OBJECT_SIZE=5368709120

# How often the lifecycle sweep runs, in seconds. The expire/tier *ages* come
# from each bucket's policy in its metadata.json — this is only the cadence.
LIFECYCLE_SCAN_INTERVAL_SECS=60

# How often the scrubber re-hashes committed blobs looking for bit rot. It also
# wakes immediately on every commit, so this is the *re*-scan interval for bytes
# nobody has read in a while.
SCRUB_RESCAN_INTERVAL_SECS=300

# How long in-flight transfers get to finish after SIGTERM. Sized against the
# thing being served: a request here is an object transfer, and cutting a
# multi-gigabyte download at five seconds to look tidy fails exactly the
# requests that were most expensive to serve.
SHUTDOWN_GRACE_SECS=30

# --- Chunk-level dedup / CDC (From the field) ---
# Content-defined chunking — NOT Change Data Capture.
# Off by default: whole-object CAS is the graded path. Turn it on and two large
# objects differing by a small edit share most of their on-disk bytes.
# See docs/10-how-chunk-level-dedup-works.md.
# CDC_ENABLED=false
# CDC_MIN_CHUNK=8192
# CDC_AVG_CHUNK=65536
# CDC_MAX_CHUNK=262144
# CDC_MIN_OBJECT=262144

# --- Auth (presigned URLs + access credentials) ---
# When SECRET_ACCESS_KEY is set, object routes accept EITHER:
#   1) a presigned URL: ?expires=<unix>&signature=<hex>
#      (mint one: POST /presign with Authorization: Bearer <KEY_ID>:<SECRET>)
#   2) access credentials on the normal path:
#      Authorization: Bearer <ACCESS_KEY_ID>:<SECRET_ACCESS_KEY>
#      (or Bearer <SECRET> alone)
# Leave SECRET_ACCESS_KEY unset for an open store (dev and tests). An unset
# secret is the off switch — there is no half-enabled state.
# ACCESS_KEY_ID=local
# SECRET_ACCESS_KEY=
