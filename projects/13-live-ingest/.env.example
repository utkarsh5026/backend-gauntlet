# Copy to .env (gitignored) and adjust. There is no database here — the source is
# a live RTMP socket and everything downstream lives in a bounded in-memory
# window. Every variable maps to one typed field in `config.py`, so an
# unparseable value fails at startup naming the variable — not silently.

# Raw-TCP port the RTMP ingest listens on (broadcasters push here).
# 0 = let the kernel choose (the tests use this).
RTMP_PORT=1935

# HTTP port the LL-HLS delivery server binds (players fetch here).
HTTP_PORT=8080

# Comma-separated list of authorized stream keys. A `publish` to a key not in this
# list is refused and the session closed — an open ingest is a takeover vector.
# Leave EMPTY to allow any key (dev only; never in production).
STREAM_KEYS=testkey

# LL-HLS part target in seconds (~200-350ms). Smaller = lower latency, more overhead.
TARGET_PART_SECS=0.3

# Full segment target in seconds. LL-HLS uses short segments (parts do the latency work).
# Must be >= TARGET_PART_SECS.
TARGET_SEGMENT_SECS=4

# How many finished segments to keep in the live window. RAM tracks this, not airtime.
LIVE_WINDOW_SEGMENTS=8

# debug | info | warning | error. Logs are JSON when stderr is not a tty.
LOG_LEVEL=info

# --- Python-specific: each publisher socket's read buffer ---
# The asyncio StreamReader `limit`. Past 2x this many unread bytes the transport
# stops reading the socket, TCP pushes back, and the *publisher's* encoder slows —
# backpressure lands on the broadcaster, not on this process's heap. See ingest.py.
RTMP_READ_BUFFER_BYTES=65536
