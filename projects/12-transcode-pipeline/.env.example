# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.
# Every variable maps to one typed field in `src/transcode_pipeline/config.py`, so
# an unparseable value fails at startup naming the variable — not silently.
# Comments sit on their own lines: an inline `# ...` after a value is not
# stripped by every reader of this file.

# Control-plane HTTP API (submit + inspect jobs)
PORT=8080
LOG_LEVEL=info

# Postgres — the durable DAG store (jobs, tasks, dependency edges, leases).
DATABASE_URL=postgres://transcode:transcode@localhost:5412/transcode
# Per process. Size it together with WORKER_CONCURRENCY and the number of worker
# processes before comparing against Postgres `max_connections`.
DB_MAX_CONNECTIONS=20

# Artifact store: sources, per-chunk transcodes, and finished renditions all live
# under here (nothing may escape it). Drop a source at e.g. $WORK_DIR/bbb.mp4 (or
# run `make fixture`) and submit `{"source": "bbb.mp4"}`.
WORK_DIR=./work

# External codec toolbox — must be on PATH (or point at a specific build).
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# --- Chunking (V1) ---
# Desired chunk length; the keyframe boundary always wins, so real chunks cluster
# around this rather than hitting it exactly.
TARGET_CHUNK_SECS=6

# --- Coordinator: scheduler + worker pool ---
# Off by default so the bare scaffold serves the control-plane API without the
# scheduler's first tick reaching an unbuilt V2 store method. Flip this on once
# the DAG store works.
RUN_WORKERS=false
# Workers in this process — the cap on concurrent ffmpeg encodes.
WORKER_CONCURRENCY=4
# How often PENDING→READY promotion + lease reaping runs.
SCHEDULER_INTERVAL_MS=500
# How often an idle worker re-checks for a READY task.
POLL_INTERVAL_MS=500

# --- Leases / retries (V3) ---
# How long a claimed task stays leased before the reaper assumes the worker died
# and makes it claimable again. Too short = a slow transcode gets double-run; too
# long = slow recovery from a crashed worker (a straggling chunk stalls the stitch).
LEASE_SECS=120
# Transcode attempts before a task is dead-lettered.
MAX_ATTEMPTS=3
