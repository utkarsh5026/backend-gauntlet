# Copy to .env and adjust. There is no database and no docker-compose here — the
# filesystem is the source.
#
# Names map one-for-one onto fields on `Settings` in src/vod_streaming/config.py:
# the type annotation there is the parser, so a bad value fails at startup with a
# message naming the variable rather than surfacing later as odd behaviour.

# Port the HTTP server binds.
PORT=8080

# Root of the media library, scanned at startup. Layout:
#   MEDIA_DIR/<asset>/<rendition>.mp4   e.g.  media/bbb/1080p.mp4, media/bbb/720p.mp4
# Two renditions of the same title is the minimum an ABR ladder needs.
# `make fixture` generates exactly that with ffmpeg if you have no source handy.
MEDIA_DIR=./media

# Target segment length in seconds. The segmenter aims for this but never splits
# a GOP to hit it — a keyframe boundary always wins, so real segments land near
# this number rather than on it.
TARGET_SEGMENT_SECS=6

# Log level: debug | info | warning | error. JSON is chosen automatically when
# stderr is not a tty (so: Docker and CI get JSON, your terminal gets colour).
LOG_LEVEL=info
