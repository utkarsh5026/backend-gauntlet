# Copy to .env and adjust. Every value has a working default — a bare `make run`
# starts an empty broker with no queues and no external dependencies.

# --- server ---
PORT=9029
HOST=0.0.0.0
LOG_LEVEL=info

# --- account identity ---
# Queue URLs embed the account id, so a URL is unambiguous about who owns the
# queue even when two accounts pick the same queue name.
ACCOUNT_ID=000000000000
AWS_REGION=us-east-1
# The host queue URLs are built from. Set this to whatever clients actually
# reach — a URL that only resolves inside the container is a URL that works in
# your tests and nowhere else.
ENDPOINT_HOST=localhost:9029

# --- queue defaults (V6) ---
# Every one of these is the *default* for a new queue; SetQueueAttributes
# overrides them per queue, and the ceilings below cap what may be set.
DEFAULT_VISIBILITY_TIMEOUT_SECONDS=30
DEFAULT_RECEIVE_WAIT_TIME_SECONDS=0
DEFAULT_DELAY_SECONDS=0
DEFAULT_RETENTION_SECONDS=345600

# --- protocol limits (the horizontal checklist's caps) ---
# 256 KB, the real SQS limit. Anything larger is an S3 pointer in the real
# world — see project 06.
MAX_MESSAGE_BYTES=262144
MAX_BATCH_ENTRIES=10
MAX_RECEIVE_MESSAGES=10
# 20s is the real ceiling, and it is a ceiling for a reason: a waiter is memory
# and a file descriptor held open, so the maximum wait is the maximum time one
# idle client can hold your resources.
MAX_RECEIVE_WAIT_TIME_SECONDS=20
# 12 hours. A lease this long means a crashed consumer's message is invisible
# for half a day — the tradeoff V1 asks you to reason about, with the extreme
# written down here.
MAX_VISIBILITY_TIMEOUT_SECONDS=43200
# 15 minutes, for both queue-level and per-message delay.
MAX_DELAY_SECONDS=900
MAX_RETENTION_SECONDS=1209600
MIN_RETENTION_SECONDS=60
MAX_QUEUE_NAME_LENGTH=80

# --- FIFO + dedup (V4, V5) ---
# 5 minutes. Long enough to cover a retrying producer, short enough that the
# window's memory stays bounded — the two constraints that pick this number.
DEDUP_WINDOW_SECONDS=300
# The hard cap on the window's size. Past this the send path must have a defined
# behaviour (reject, or evict) rather than growing until the process dies.
MAX_DEDUP_ENTRIES=1000000

# --- quotas (the security horizontal) ---
# Real SQS caps in-flight messages per queue: 120,000 standard, 20,000 FIFO.
# The cap exists because an in-flight message is server-side state a consumer
# can acquire and simply never release.
MAX_INFLIGHT_PER_QUEUE=120000
MAX_INFLIGHT_PER_FIFO_QUEUE=20000
# Parked long-poll waiters, process-wide. The boss fight parks 10,000 of them;
# this is the number that decides whether the 10,001st is refused or accepted.
MAX_WAITERS=20000
MAX_QUEUES=1000

# --- the deadline engine (V2) ---
# How often the timer loop wakes when nothing is due. Not a polling interval for
# messages — the engine should sleep until the *next deadline*; this is the
# safety net that bounds how long a missed wakeup can go unnoticed.
TIMER_TICK_SECONDS=0.05
# The most deadlines one tick will process before yielding to the event loop.
# Without a bound, a tick with a million due deadlines is a stalled server.
MAX_DEADLINES_PER_TICK=10000

# --- authentication (the SigV4 horizontal, project 25) ---
# Off by default so the scaffold is pokeable with curl. Turn it on and every
# request must be SigV4-signed and authorized — which is the checklist bar.
REQUIRE_SIGV4=false
# Project 25's authorization endpoint. Only used when REQUIRE_SIGV4 is true.
IAM_AUTHZ_URL=http://127.0.0.1:9026
