# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.

# Server
PORT=8080
LOG_LEVEL=info               # debug | info | warning | error
                             # JSON is chosen automatically when stderr is not a
                             # tty (Docker, CI); colour locally.

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://shortener:shortener@localhost:5401/shortener

# Redis (matches docker-compose.yml)
REDIS_URL=redis://localhost:6301/0

# This instance's node id for the Snowflake ID generator.
# MUST be unique per running instance (0..=1023). See src/url_shortener/id_gen.py.
NODE_ID=1

# Comma-separated API keys accepted on write/stats endpoints.
# In a real system these'd be hashed in a DB; this is the scaffold's stand-in.
API_KEYS=dev-secret-key

# Origin used to build the short_url in a create response. Defaults to
# http://localhost:$PORT — set it to the real origin when behind a proxy.
# PUBLIC_BASE_URL=https://short.example.com

# Postgres pool bounds. Every pooled connection is a backend process on the
# server, so max × replicas must stay under its max_connections.
DB_POOL_MIN=2
DB_POOL_MAX=20
