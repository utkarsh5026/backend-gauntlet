# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.
#
# One process is ONE regional SFU. To run a cascade, launch several instances with
# different REGION / NODE_ID / ports / PEERS (see SPEC.md "Run it", or `make mesh`).
# There is no Postgres/Redis/NATS: the control plane is consensus this process builds
# (V1), the media plane is SFU-to-SFU UDP (V2), and recordings are written to local
# disk (V4). Environment variables beat this file, which is what lets `make mesh`
# start three regions from one `.env`.

# --- This node's identity in the mesh ---
REGION=eu-west               # this SFU's region (also the home-region label for rooms it anchors)
NODE_ID=n1                   # stable id for THIS node (used in consensus + logs; in k8s, the pod name)

# --- HTTP: signaling + inter-SFU cluster control + admin all share this listener ---
HTTP_PORT=8080
LOG_LEVEL=info               # JSON when stderr is not a tty (Docker/CI), colour on a terminal

# --- Media planes (UDP) ---
MEDIA_PORT=7000              # participant-facing muxed socket (STUN/RTP/RTCP), as in project 15
CASCADE_PORT=7100            # backbone socket that relays media between SFUs (V2)
# The address this SFU advertises to clients as its ICE host candidate (where they send
# their STUN checks + media). Set to the node's reachable IP in a real deployment.
PUBLIC_IP=127.0.0.1

# How many inbound datagrams may queue between the event loop's receive callback and
# whatever drains that socket before it starts dropping. `datagram_received` is a
# callback and cannot await, so a full queue leaves two options — drop, or grow without
# limit on a port anyone can send to. It drops, and counts it:
# `conf_datagrams_dropped_total{plane,reason="inbox_full"}`.
MEDIA_INBOX=1024
CASCADE_INBOX=4096           # the backbone aggregates every remote region's relay copies

# --- The mesh: the other regional SFUs (V1 consensus peers + V2 relay targets) ---
# Comma-separated `region=<http-control-base>|<cascade-udp-addr>`. Empty = a lone SFU
# (single region, no cascade — behaves like project 15). Parsed strictly at startup: a
# silently-dropped peer changes the quorum. Example for a 3-region mesh:
#   PEERS=us-east=http://127.0.0.1:8081|127.0.0.1:7101,ap-south=http://127.0.0.1:8082|127.0.0.1:7102
PEERS=

# --- Bounds (backpressure / abuse protection) ---
MAX_ROOMS=256                # cluster-wide cap, enforced through the placement log (V1)
MAX_PEERS_PER_ROOM=512
MAX_RELAY_LINKS=16           # cap on concurrent backbone legs this SFU opens (V2)

# --- Placement consensus (V1) — the Raft-lite knobs from project 09 ---
# Randomized election timeout base (ms): a follower waits a random interval in
# [ELECTION_TIMEOUT_MS, 2*ELECTION_TIMEOUT_MS) before standing for election, so split
# votes resolve. Heartbeat must be below this (checked at startup).
ELECTION_TIMEOUT_MS=1000
HEARTBEAT_MS=300
# Per-RPC timeout for /cluster/* calls. Tune against HEARTBEAT_MS, not against how long a
# healthy call takes: a hung peer must never stall an election round.
CLUSTER_RPC_TIMEOUT_MS=250

# --- Cross-region routing (V3) ---
# Hysteresis hold: how many recompute ticks a layer must stay un-demanded before it is
# dropped from a backbone leg (damps a flapping subscriber). Documented in the design doc.
HYSTERESIS_TICKS=3

# --- Recording (V4) ---
RECORDING_DIR=./recordings   # where segmented recordings are written
SEGMENT_SECS=6               # recording segment length (crash loses at most one open segment)

# --- Background loops (the placement election/heartbeat) ---
# Off by default so the bare scaffold serves the API without driving a V1 NotImplementedError
# with no input. Flip to true (and set PEERS) once V1 is implemented, to run a live mesh.
RUN_BACKGROUND=false
