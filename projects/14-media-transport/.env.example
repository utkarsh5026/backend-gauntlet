# Copy to .env (gitignored) and adjust. All values have defaults; nothing here
# is a secret. Every variable maps to one typed field in `config.py`, so an
# unparseable value fails at startup naming the variable — not silently.

# --- roles & sockets ---
# Which side this process plays: `receiver` (binds and consumes) or `sender`
# (produces). An unknown value is a startup error, not a silent default.
ROLE=receiver
# UDP port for the RTP/RTCP media plane. 0 = let the kernel choose (the tests
# use this so several transports can run at once).
RTP_PORT=5004
# TCP port for the admin surface (/healthz, /readyz, /status, /metrics).
HTTP_PORT=8080
# Sender only: where to send RTP, as host:port. Required for ROLE=sender.
# REMOTE_ADDR=127.0.0.1:5004

LOG_LEVEL=info

# --- packetization (V1) ---
# Max UDP payload per packet, header included. 1200 stays under the common
# 1500-byte path MTU with room for IP/UDP and a tunnel, so V1 fragments at the
# application layer instead of relying on IP fragmentation.
MTU=1200
# RTP payload type (96 = a dynamic type, typical for H.264). 7 bits on the wire.
PAYLOAD_TYPE=96

# --- jitter buffer (V2) ---
# Target playout delay in ms: how long a packet waits before it may be released.
# Bigger absorbs more jitter and costs more latency — the boss fight caps the
# added latency at 150 ms, so this is the knob that criterion is about.
PLAYOUT_MS=100
# Hard cap on buffered packets: the OOM guard against a peer that floods future
# sequence numbers or never marks a frame.
JITTER_CAPACITY=4096

# --- retransmission (V3) ---
# How many recently sent packets the sender keeps to answer NACKs. At 1.5 Mbps
# in 1200-byte packets this is roughly 6.5 s of history — far longer than any
# playout deadline, which is why the *deadline* check has to do the real work
# rather than eviction.
RTX_CACHE_PACKETS=1024

# --- congestion control (V4), in kilobits/sec ---
MIN_KBPS=300
START_KBPS=1500
MAX_KBPS=4000

# --- synthetic media source (sender, when no real RTP feed is used) ---
FPS=30
# Keyframe interval, in frames.
GOP=60

# --- the event loop's inbound queue (Python) ---
# Bounded on purpose. The loop's receive callback cannot await, so a full queue
# drops rather than growing — an unbounded queue on an open UDP port is a remote
# OOM with no authentication in front of it. Too small sheds a keyframe's burst
# of fragments; too large just moves the latency into a queue, which on a media
# path is worse than dropping. See `udp.py`.
RTP_INBOX=1024
