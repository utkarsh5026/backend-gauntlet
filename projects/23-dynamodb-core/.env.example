# Copy to .env and adjust. Every value has a sane default — a bare `make run`
# starts a single node with an empty table set.

# --- server ---
# HTTP API port. 8000 is DynamoDB Local's conventional port.
PORT=8000
LOG_LEVEL=info

# --- storage (V1) ---
# Where the write-ahead log and table files live.
DATA_DIR=./data
# Per-item size cap, enforced before storage. DynamoDB's real limit is 400 KB.
MAX_ITEM_BYTES=409600

# --- capacity (V4) ---
# Table-wide provisioned capacity units, the budget a table is created with.
DEFAULT_READ_CAPACITY=1000
DEFAULT_WRITE_CAPACITY=1000
# The per-partition ceiling — the number that makes a hot key throttle while the
# table as a whole looks idle. DynamoDB's real figure is 3000 RCU / 1000 WCU.
PARTITION_READ_CAPACITY=3000
PARTITION_WRITE_CAPACITY=1000
# Seconds of unused capacity a partition may bank and spend in a spike.
BURST_SECONDS=300

# --- streams (V5) ---
# How long a stream record is retained before it is trimmed (DynamoDB: 24h).
STREAM_RETENTION_HOURS=24
# Bounded in-memory buffer per stream. A slow consumer must cost bounded memory.
STREAM_BUFFER_SIZE=10000
