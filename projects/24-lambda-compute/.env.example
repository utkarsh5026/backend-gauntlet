# Copy to .env and adjust. Every value has a sane default — a bare `make run`
# starts a node with no functions registered.

# --- server ---
# The control/invoke plane: register functions and invoke them.
PORT=9001
# The Runtime API, on its own listener. Real Lambda puts this at
# AWS_LAMBDA_RUNTIME_API=127.0.0.1:9001 inside the sandbox; here it is a separate
# port on purpose, so "the sandbox can reach the Runtime API and nothing else"
# (V3) is a boundary you can actually test rather than a comment.
RUNTIME_API_PORT=9002
# The address handed to a sandbox as AWS_LAMBDA_RUNTIME_API. Loopback only —
# an execution environment has no business reaching the network.
RUNTIME_API_HOST=127.0.0.1
LOG_LEVEL=info

# --- function defaults (V1/V2) ---
# Applied when a function is registered without its own value.
DEFAULT_MEMORY_MB=128
DEFAULT_TIMEOUT_SECONDS=3
# Cap on a synchronous request/response payload. Real Lambda: 6 MB sync, 256 KB async.
MAX_SYNC_PAYLOAD_BYTES=6291456
MAX_ASYNC_PAYLOAD_BYTES=262144

# --- execution environments (V2) ---
# How long an idle environment lives before it is reaped. Real Lambda's is
# undocumented and variable (minutes); a short one here makes reaping testable.
ENVIRONMENT_IDLE_TTL_SECONDS=300
# Ceiling on environments alive at once on this node — memory is finite, and an
# unbounded warm pool is how a node dies.
MAX_ENVIRONMENTS=256
# How long a runtime may take to complete init before the environment is scrapped.
INIT_TIMEOUT_SECONDS=10

# --- sandbox (V3) ---
# Where each environment's /tmp lives. One subdirectory per environment, removed
# when it is reaped — cross-environment visibility is the thing V3 forbids.
SANDBOX_ROOT=./run
# Per-environment scratch quota. Real Lambda gives 512 MB by default.
SANDBOX_TMP_MB=512

# --- concurrency (V4) ---
# The account-wide ceiling every function shares. Real Lambda's default is 1000.
ACCOUNT_CONCURRENCY_LIMIT=1000
# How many *new* environments may be started per second once the burst ceiling is
# spent. This rate — not the limit — is what shapes a cold front.
SCALE_UP_RATE_PER_SECOND=500
# Instantaneous burst allowance before the scale-up rate takes over.
BURST_CONCURRENCY=500

# --- async invocation (V5) ---
# Bounded on purpose: a producer faster than the consumer must be told, not buffered.
ASYNC_QUEUE_SIZE=10000
# Attempts INCLUDING the first. Real Lambda: 1 + 2 retries.
ASYNC_MAX_ATTEMPTS=3
ASYNC_RETRY_BASE_SECONDS=1
# An event older than this is dead-lettered rather than executed against a stale world.
ASYNC_MAX_EVENT_AGE_SECONDS=21600

# --- event source mapping (V6) ---
# Where the poller reads from. Project 23's stream endpoint, if you have it running.
EVENT_SOURCE_URL=http://localhost:8000
# Invoke on whichever of these fills first — the window is what stops a low-rate
# stream from stalling until a full batch accumulates.
EVENT_SOURCE_BATCH_SIZE=100
EVENT_SOURCE_BATCH_WINDOW_SECONDS=1.0
# Concurrent invocations per shard. 1 preserves per-key ordering; raising it is a
# tradeoff V6 asks you to make explicit.
EVENT_SOURCE_PARALLELISATION=1
