{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug api-gateway",
      "cargo": {
        "args": ["build", "--bin=api-gateway", "--package=api-gateway"],
        "filter": { "name": "api-gateway", "kind": "bin" }
      },
      "args": [],
      "cwd": "${workspaceFolder}/projects/10-api-gateway",
      "envFile": "${workspaceFolder}/projects/10-api-gateway/.env"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug url-shortener",
      "cargo": {
        "args": ["build", "--bin=url-shortener", "--package=url-shortener"],
        "filter": { "name": "url-shortener", "kind": "bin" }
      },
      "args": [],
      "cwd": "${workspaceFolder}/projects/01-url-shortener",
      "envFile": "${workspaceFolder}/projects/01-url-shortener/.env"
    },
    {
      "type": "debugpy",
      "request": "launch",
      "name": "Debug tools/status.py",
      "program": "${workspaceFolder}/tools/status.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "type": "debugpy",
      "request": "launch",
      "name": "Debug tools/status.py (project 10)",
      "program": "${workspaceFolder}/tools/status.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": ["10"],
      "justMyCode": true
    }
  ]
}
