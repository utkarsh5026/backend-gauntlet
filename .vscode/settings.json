{
  "editor.fontFamily": "'Source Code Pro', 'CaskaydiaCove Nerd Font Mono', 'CaskaydiaMono Nerd Font', 'Cascadia Code', Consolas, monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 14,
  "editor.lineHeight": 1.8,
  "editor.letterSpacing": 0.2,
  "editor.padding.top": 14,
  "editor.padding.bottom": 14,
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorWidth": 2,
  "editor.smoothScrolling": true,
  "editor.roundedSelection": true,
  // Calm chrome: no minimap, hairline scrollbar, highlight the gutter not the line.
  "editor.minimap.enabled": false,
  "editor.renderLineHighlight": "gutter",
  "editor.overviewRulerBorder": false,
  "editor.hideCursorInOverviewRuler": true,
  "editor.scrollbar.verticalScrollbarSize": 10,
  "editor.scrollbar.horizontalScrollbarSize": 10,
  "editor.scrollBeyondLastLine": false,
  // Structure you can read at a glance.
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.guides.indentation": true,
  "editor.stickyScroll.enabled": true,
  "editor.stickyScroll.maxLineCount": 3,
  "editor.renderWhitespace": "boundary",
  "editor.semanticHighlighting.enabled": true,
  "breadcrumbs.enabled": true,
  // ── Workbench ─────────────────────────────────────────────────────────────
  "workbench.startupEditor": "none",
  "workbench.list.smoothScrolling": true,
  "workbench.tree.indent": 14,
  "workbench.tree.renderIndentGuides": "always",
  "workbench.editor.labelFormat": "short",
  "workbench.editor.tabSizing": "shrink",
  "explorer.compactFolders": false,
  "explorer.confirmDragAndDrop": false,
  // Fold the satellite files under the one you actually open.
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "Cargo.toml": "Cargo.lock, rust-toolchain.toml, rustfmt.toml, clippy.toml, deny.toml, .cargo",
    "pyproject.toml": "uv.lock, poetry.lock, ruff.toml, .python-version, mypy.ini",
    "Makefile": "makefile.py, makefile_*.py",
    "SPEC.md": "RESEARCH.md, CONCEPTS.md, NOTES.md, TRANSFER.md",
    "README.md": "CLAUDE.md, AGENTS.md, LICENSE, .editorconfig, .tome.json",
    "docker-compose.yml": "docker-compose.*.yml, Dockerfile*, .dockerignore",
    ".env.example": ".env, .env.*"
  },
  // ── Editor behaviour ──────────────────────────────────────────────────────
  "editor.formatOnSave": true,
  "editor.rulers": [
    100
  ],
  "editor.codeActionsOnSave": {
    "source.fixAll.rust": "explicit",
    "source.organizeImports.rust": "explicit"
  },
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  // Error Lens: inline diagnostics that read as a note, not a billboard.
  "errorLens.fontStyleItalic": true,
  "errorLens.messageBackgroundMode": "none",
  "errorLens.gutterIconsEnabled": true,
  "errorLens.delay": 300,
  "errorLens.enabledDiagnosticLevels": [
    "error",
    "warning"
  ],
  // ── Per-language ──────────────────────────────────────────────────────────
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.formatOnSave": true
  },
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml"
  },
  "[markdown]": {
    // Prettier was silently re-flowing hand-tuned tables in SPEC.md / docs/ on
    // every save (padding every cell to column width). The prose here is written
    // by hand — leave it alone.
    "editor.formatOnSave": false,
    "editor.wordWrap": "on",
    "editor.rulers": [],
    "editor.renderWhitespace": "none",
    "editor.quickSuggestions": {
      "other": false,
      "comments": false,
      "strings": false
    },
    "files.trimTrailingWhitespace": false
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.rulers": [
      100
    ],
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  // ── Rust / rust-analyzer ──────────────────────────────────────────────────
  "rust-analyzer.check.command": "clippy",
  // Only check the crate being edited, not all 24 workspace members on every save.
  // `make check` / CI still cover the whole workspace.
  "rust-analyzer.check.workspace": false,
  "rust-analyzer.check.extraArgs": [
    "--",
    "-D",
    "warnings"
  ],
  "rust-analyzer.cargo.buildScripts.enable": true,
  // Only 06-object-store defines [features] (test-only helpers), so "all" bought
  // nothing across 21 crates while inflating the crate graph. Flip back to "all"
  // if you start gating real code behind features.
  "rust-analyzer.cargo.features": [],
  // Don't build every test/bench/example target just to lint on save.
  "rust-analyzer.check.allTargets": false,
  // Skip the on-open warm-up that eagerly primes all 21 workspace members.
  "rust-analyzer.cachePriming.enable": false,
  // Leave cores for the Python side and Docker instead of saturating all 16.
  "rust-analyzer.numThreads": 6,
  // The Rust side never needs to see the Python projects or any frontend.
  "rust-analyzer.files.excludeDirs": [
    ".venv",
    "site",
    "packages",
    "projects/02-rate-limiter",
    "projects/07-distributed-cache",
    "projects/08-message-broker",
    "projects/20-full-text-search",
    "projects/23-dynamodb-core",
    "projects/24-lambda-compute",
    "projects/25-iam-sts",
    "projects/29-sqs-queue"
  ],
  "rust-analyzer.procMacro.enable": true,
  "rust-analyzer.lens.run.enable": true,
  "rust-analyzer.lens.debug.enable": true,
  "rust-analyzer.inlayHints.parameterHints.enable": true,
  "rust-analyzer.inlayHints.typeHints.enable": true,
  "rust-analyzer.inlayHints.chainingHints.enable": true,
  "rust-analyzer.completion.callable.snippets": "fill_arguments",
  // sqlx `query!` macros must use the committed `.sqlx/` cache — not a live DB.
  // rust-analyzer does not reliably inherit `[env]` from `.cargo/config.toml`, so
  // set SQLX_OFFLINE here explicitly. Do NOT set DATABASE_URL (stale socket → EOF).
  "rust-analyzer.cargo.extraEnv": {
    "SQLX_OFFLINE": "true"
  },
  // ── Python ────────────────────────────────────────────────────────────────
  // The uv workspace installs every member editable into the ROOT .venv (3.13).
  // Pointing at /usr/bin/python3 (3.10) made Pylance fail to resolve fastapi,
  // pydantic, botocore… -> thousands of phantom diagnostics and a huge index.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": false,
  "python.languageServer": "Pylance",
  "python.analysis.typeCheckingMode": "basic",
  // `workspace` re-analyses every .py in all 26 projects on every keystroke —
  // it was costing ~2.6 GB of RSS. `make verify` / CI still run pyright strict
  // over the whole project, which is where the real gate belongs.
  "python.analysis.diagnosticMode": "openFilesOnly",
  // Keep the indexer out of everything that isn't hand-written source.
  "python.analysis.exclude": [
    "**/target/**",
    "**/node_modules/**",
    "**/.venv/**",
    "**/__pycache__/**",
    "**/.ruff_cache/**",
    "**/.mypy_cache/**",
    "**/.pytest_cache/**",
    "site/**",
    "**/web/**"
  ],
  // `makefile.py` inserts `tools/` on sys.path itself, so only that one entry is
  // load-bearing — the per-project paths that used to be here were dead weight
  // (uv installs each project editable, so its own imports already resolve).
  "python.analysis.extraPaths": [
    "${workspaceFolder}/tools"
  ],
  "cursorpyright.analysis.typeCheckingMode": "basic",
  "cursorpyright.analysis.diagnosticMode": "openFilesOnly",
  "cursorpyright.analysis.extraPaths": [
    "${workspaceFolder}/tools"
  ],
  "ruff.configurationPreference": "filesystemFirst",
  "ruff.lineLength": 100,
  // ── Terminal (opens in the project we're actively building) ───────────────
  "terminal.integrated.cwd": "${workspaceFolder}/projects/10-api-gateway",
  "terminal.integrated.envFile": "${workspaceFolder}/projects/10-api-gateway/.env",
  // Same Nerd Font as Windows Terminal, so the tmux powerline statusline renders.
  "terminal.integrated.fontFamily": "'CaskaydiaCove Nerd Font Mono', 'CaskaydiaMono Nerd Font', monospace",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.lineHeight": 1.2,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.minimumContrastRatio": 4.5,
  // ── Noise reduction ───────────────────────────────────────────────────────
  // Sizes that matter here: node_modules 544 MB across 11 frontends, .venv 197 MB
  // / 12.7k files, target/ 1.4 GB, site/ 263 MB. Watching those in WSL2 is what
  // makes the whole window feel sticky.
  "files.exclude": {
    "**/__pycache__": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/.pytest_cache": true,
    "**/*.egg-info": true
  },
  "files.watcherExclude": {
    "**/target/**": true,
    "**/.venv/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/__pycache__/**": true,
    "**/.ruff_cache/**": true,
    "**/.mypy_cache/**": true,
    "**/.pytest_cache/**": true,
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true
  },
  "search.exclude": {
    "**/target": true,
    "**/.venv": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/__pycache__": true,
    "**/.sqlx": true,
    "Cargo.lock": true,
    "uv.lock": true,
    "**/bun.lock": true
  },
  // Ripgrep already honours .gitignore; make the quick-open picker do the same.
  "search.useIgnoreFiles": true,
  "search.followSymlinks": false
}
